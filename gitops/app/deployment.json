{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "name": "workplace-status",
    "annotations": {
      "portfolio/owner": "synthetic-gitops-lab"
    }
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app.kubernetes.io/name": "workplace-status"
      }
    },
    "template": {
      "metadata": {
        "labels": {
          "app.kubernetes.io/name": "workplace-status"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 10001,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "containers": [
          {
            "name": "workplace-status",
            "image": "nordic-service:lab-000000000001",
            "imagePullPolicy": "Never",
            "ports": [
              {
                "containerPort": 8080
              }
            ],
            "resources": {
              "requests": {
                "cpu": "100m",
                "memory": "64Mi"
              },
              "limits": {
                "cpu": "500m",
                "memory": "128Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "readOnlyRootFilesystem": true,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              }
            },
            "readinessProbe": {
              "httpGet": {
                "path": "/not-ready",
                "port": 8080
              },
              "initialDelaySeconds": 2
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": 8080
              },
              "initialDelaySeconds": 5
            }
          }
        ]
      }
    }
  }
}

